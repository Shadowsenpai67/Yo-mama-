# Supabase public browser credentials
# Get these from Supabase Dashboard -> Connect / API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Only needed if you later add privileged server-side Supabase operations.
# NEVER expose a Supabase secret/service-role key with NEXT_PUBLIC_.
